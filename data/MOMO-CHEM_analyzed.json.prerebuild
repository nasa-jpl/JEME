  {
    "title": "Ground-based tropospheric ozone measurements: regional tropospheric ozone column trends from the TOAR-II/HEGIFTOM homogenized datasets",
    "authors": [
      "R. van Malderen",
      "Zhou Zang",
      "Kai-Lan Chang",
      "Robin Björklund",
      "Owen R. Cooper",
      "Jane Liu",
      "Eliane Maillard Barras",
