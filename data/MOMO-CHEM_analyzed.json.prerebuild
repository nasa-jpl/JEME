  {
    "title": "Quantification of the effect of modeled lightning NO 2 on UV-visible air mass factors",
    "authors": [
      "J. Laughner",
      "Ronald C. Cohen"
    ],
    "year": 2017,
    "doi": "10.5194/AMT-10-4403-2017",
    "venue": "Atmospheric Measurement Techniques",
