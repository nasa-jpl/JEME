          2019,
          1,
          1
        ]
      ]
    },
    "citing_team_paper": "Intercomparison of NOx emission inventories over East Asia",
    "team_paper_id": "55225c4d40048ab9f81bf71ccba71f1f9fb3535d",
    "research_domain": "Air Quality & Health",
    "engagement_level": "Citation",
    "missions_instruments": [],
    "uncertainty": {
      "reasoning_confidence": 0.8,
      "evidence_confidence": 0.775,
