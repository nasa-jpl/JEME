  {
    "title": "Neutral Tropical African CO2 Exchange Estimated From Aircraft and Satellite Observations",
    "authors": [
      "B. Gaubert",
      "Britton B. Stephens",
      "David F. Baker",
      "S. Basu",
      "M. Bertolacci",
      "K. Bowman",
      "R. Buchholz",
