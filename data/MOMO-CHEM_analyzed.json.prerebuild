  {
    "title": "Evaluating the consistency between OCO-2 and OCO-3 XCO2 estimates derived from the NASA ACOS version 10 retrieval algorithm",
    "authors": [
      "T. Taylor",
      "C. O’Dell",
      "D. Baker",
      "C. Bruegge",
      "A. Chang",
      "L. Chapsky",
      "A. Chatterjee",
