  {
    "title": "Mapping \\documentclass[12pt]{minimal} \\usepackage{amsmath} \\usepackage{wasysym} \\usepackage{amsfonts} \\usepackage{amssymb} \\usepackage{amsbsy} \\usepackage{mathrsfs} \\usepackage{upgreek} \\setlength{\\oddsidemargin}{-69pt} \\begin{document}$$\\text {NO}_{\\text {x}}$$\\end{document}NOx emissions in Cyprus ",
    "authors": [
      "Anthony Rey-Pommier",
      "Frédéric Chevallier",
      "Philippe Ciais",
      "T. Christoudias",
