  {
    "title": "Atmospheric Evolution of Brown Carbon from Wildfires in North America.",
    "authors": [
      "Jhao-Hong Chen",
      "Uma Puttu",
      "Han N. Huynh",
      "A. T. Ahern",
      "K. Ball",
      "Kelvin H. Bates",
      "Charles A. Brock",
      "Teresa Campos",
      "M. Coggon",
