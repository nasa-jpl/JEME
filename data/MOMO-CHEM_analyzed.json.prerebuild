  {
    "title": "Observational ozone datasets over the global oceans and polar regions (version 2024)",
    "authors": [
      "Yugo Kanaya",
      "R. Sommariva",
      "Alfonzo Saiz‐Lopez",
      "Andrea Mazzeo",
      "T. Koenig",
      "K. Kawana",
      "James E. Johnson",
      "A. Colomb",
      "P. Tulet",
