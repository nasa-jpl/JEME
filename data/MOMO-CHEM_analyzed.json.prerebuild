  {
    "title": "Environmental effects of stratospheric ozone depletion, UV radiation, and interactions with climate change: UNEP Environmental Effects Assessment Panel, Update 2021",
    "authors": [
      "P. Barnes",
      "T. Robson",
      "P. Neale",
      "C. Williamson",
      "R. Zepp",
      "S. Madronich",
