  {
    "title": "Satellite and In Situ Observations for Advancing Global Earth Surface Modelling: A Review",
    "authors": [
      "G. Balsamo",
      "A. Agustí-Panareda",
      "C. Albergel",
      "G. Arduini",
      "A. Beljaars",
      "J. Bidlot",
