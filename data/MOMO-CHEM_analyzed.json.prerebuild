  {
    "title": "Coupled Air Quality and Boundary-Layer Meteorology in Western U.S. Basins during Winter: Design and Rationale for a Comprehensive Study.",
    "authors": [
      "A. Hallar",
      "S. Brown",
      "E. Crosman",
      "K. Barsanti",
      "C. Cappa",
      "I. Faloona",
      "J. Fast",
      "H. Holmes",
