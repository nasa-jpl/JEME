  {
    "title": "COVID‐19 Crisis Reduces Free Tropospheric Ozone Across the Northern Hemisphere",
    "authors": [
      "W. Steinbrecht",
      "D. Kubistin",
      "C. Plass-Dülmer",
      "J. Davies",
      "D. Tarasick",
      "P. von der Gathen",
      "H. Deckelmann",
      "N. Jepsen",
      "R. Kivi",
