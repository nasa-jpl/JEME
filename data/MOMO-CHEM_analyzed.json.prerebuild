  {
    "title": "Permafrost–wildfire interactions: active layer thickness estimates for paired burned and unburned sites in northern high latitudes",
    "authors": [
      "Anna C. Talucci",
      "M. Loranty",
      "Jean E. Holloway",
      "Brendan M. Rogers",
      "Heather D. Alexander",
      "Natalie Baillargeon",
