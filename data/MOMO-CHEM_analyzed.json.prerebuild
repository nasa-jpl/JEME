  {
    "title": "Assessing the impacts of assimilating IASI and MOPITT CO retrievals using CESM‐CAM‐chem and DART",
    "authors": [
      "J. Barré",
      "B. Gaubert",
      "A. Arellano",
      "H. Worden",
      "D. Edwards",
      "M. Deeter",
      "Jeffrey L. Anderson",
